{
  // The "Run it for real" machine of the journeys on docs.quirq.dev: a
  // reader's own Codespace with qq, qqsync and the xo CLI installed, so every
  // command in a guide really runs. It holds no key or token of ours. xo's
  // browser sign-in cannot finish here (it returns to 127.0.0.1 on the
  // reader's device); `xo login --key` works for someone with an XO API key.
  // Never turn on Codespaces prebuilds or add Codespaces secrets for it:
  // prebuilds bill the repo owner.
  "name": "quirq playground",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "os-provided" }
  },
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "bash .devcontainer/playground/setup.sh",
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/playground/README.md"] }
  }
}
