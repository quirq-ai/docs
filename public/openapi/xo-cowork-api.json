{
  "openapi": "3.1.0",
  "info": {
    "title": "XO Cowork API — Safe Explorer",
    "version": "1.0.0",
    "summary": "Read-only discovery and workspace inspection endpoints",
    "description": "A curated, read-only contract for the XO Cowork control plane. It is intentionally smaller than the service's internal OpenAPI document: credential management, file contents, agent execution, connector tokens, backup/restore, and lifecycle controls are excluded from interactive use. Requests affect the selected real workspace; this is not a mock server.",
    "license": {
      "name": "Internal XO developer documentation"
    }
  },
  "externalDocs": {
    "description": "XO Cowork API guides and full behavioral documentation",
    "url": "https://docs.quirq.dev/more/xo-cowork-api"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5002",
      "description": "Local XO Cowork workspace"
    }
  ],
  "security": [
    {},
    {
      "WorkspaceProxyBearer": []
    },
    {
      "CoderSessionToken": []
    }
  ],
  "tags": [
    {
      "name": "Connect",
      "description": "Confirm the service and inspect the active runtime."
    },
    {
      "name": "Runtime status",
      "description": "Read model, provider, and channel readiness from the active agent backend. Some backends return 501 when a capability is not implemented."
    },
    {
      "name": "Workspace",
      "description": "Read workspace-local configuration and agent metadata. These responses can reveal local paths and names."
    },
    {
      "name": "Sessions",
      "description": "Read conversation metadata and messages stored in the selected workspace."
    },
    {
      "name": "Usage",
      "description": "Inspect workspace-local token, cost, and tool telemetry."
    }
  ],
  "x-tagGroups": [
    {
      "name": "Explore safely",
      "tags": [
        "Connect",
        "Runtime status",
        "Workspace",
        "Sessions",
        "Usage"
      ]
    }
  ],
  "x-xo-source-revision": "f5a4505fc786",
  "x-xo-scope": "read-only-curated",
  "paths": {
    "/": {
      "get": {
        "tags": ["Connect"],
        "summary": "Confirm the Cowork API is running",
        "description": "The safest first request. It returns only the service banner and does not expose the diagnostic details returned by `/health`.",
        "operationId": "getCoworkStatus",
        "x-xo-risk": "read-only-status",
        "responses": {
          "200": {
            "description": "Cowork API banner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceStatus"
                },
                "example": {
                  "status": "XO Cowork API running"
                }
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": ["Connect"],
        "summary": "List models exposed by the active runtime",
        "description": "Returns the active backend's model/profile rows. The exact row shape depends on the selected agent backend.",
        "operationId": "listAvailableModels",
        "x-xo-risk": "read-only-status",
        "responses": {
          "200": {
            "description": "Model rows for the active backend",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlexibleObject"
                  }
                },
                "example": [
                  {
                    "id": "main",
                    "name": "Main agent",
                    "model": "configured-by-runtime"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/models/status": {
      "get": {
        "tags": ["Runtime status"],
        "summary": "Inspect live model readiness",
        "description": "Dispatches to the active backend's model-status capability. Returns 501 when that backend does not provide live status.",
        "operationId": "getModelsStatus",
        "x-xo-risk": "read-only-status",
        "responses": {
          "200": {
            "description": "Backend-specific model status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlexibleObject"
                }
              }
            }
          },
          "501": {
            "$ref": "#/components/responses/CapabilityUnavailable"
          }
        }
      }
    },
    "/providers/status": {
      "get": {
        "tags": ["Runtime status"],
        "summary": "Inspect model-provider connection state",
        "description": "Reports live connection state only for providers enabled by the active workspace manifest. Secret values are not returned.",
        "operationId": "getProvidersStatus",
        "x-xo-risk": "read-only-status",
        "responses": {
          "200": {
            "description": "Backend-specific provider status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlexibleObject"
                }
              }
            }
          },
          "501": {
            "$ref": "#/components/responses/CapabilityUnavailable"
          }
        }
      }
    },
    "/channels/status": {
      "get": {
        "tags": ["Runtime status"],
        "summary": "Inspect live channel readiness",
        "description": "Returns channel configuration and running state from the active backend. Returns 501 when that backend has no live channel-status source.",
        "operationId": "getChannelsStatus",
        "x-xo-risk": "read-only-status",
        "responses": {
          "200": {
            "description": "Backend-specific channel status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlexibleObject"
                }
              }
            }
          },
          "501": {
            "$ref": "#/components/responses/CapabilityUnavailable"
          }
        }
      }
    },
    "/api/config/workspace": {
      "get": {
        "tags": ["Workspace"],
        "summary": "Discover workspace roots and the active backend",
        "description": "Returns canonical local paths. Use `roots[default]` instead of hardcoding `~/xo-projects`. This response reveals filesystem locations in the selected workspace.",
        "operationId": "getWorkspaceConfiguration",
        "x-xo-risk": "workspace-data",
        "responses": {
          "200": {
            "description": "Workspace roots keyed by backend",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceConfiguration"
                },
                "example": {
                  "roots": {
                    "openclaw": "/home/coder/xo-projects",
                    "hermes": "/home/coder/.hermes"
                  },
                  "default": "openclaw"
                }
              }
            }
          }
        }
      }
    },
    "/api/agents": {
      "get": {
        "tags": ["Workspace"],
        "summary": "List agents for the active backend",
        "description": "Returns only the agents owned by the backend selected through `AGENT_NAME`.",
        "operationId": "listWorkspaceAgents",
        "x-xo-risk": "workspace-data",
        "responses": {
          "200": {
            "description": "Agent summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "tags": ["Sessions"],
        "summary": "List conversation sessions",
        "description": "Returns the current page as an array, newest-first according to the active adapters. It does not return a total-count envelope.",
        "operationId": "listSessions",
        "x-xo-risk": "workspace-data",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit50"
          },
          {
            "$ref": "#/components/parameters/Offset0"
          }
        ],
        "responses": {
          "200": {
            "description": "Session metadata rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Session"
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/sessions/search": {
      "get": {
        "tags": ["Sessions"],
        "summary": "Search session titles",
        "description": "Performs a case-insensitive substring match against each session title.",
        "operationId": "searchSessions",
        "x-xo-risk": "workspace-data",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Title substring. An empty value matches every session.",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of search results.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1
            }
          },
          {
            "$ref": "#/components/parameters/Offset0"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching sessions and optional snippets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionSearchResult"
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/sessions/{session_id}": {
      "get": {
        "tags": ["Sessions"],
        "summary": "Get one session",
        "description": "Looks up session metadata across the installed runtime adapters.",
        "operationId": "getSession",
        "x-xo-risk": "workspace-data",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Session metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/messages/{session_id}": {
      "get": {
        "tags": ["Sessions"],
        "summary": "Read messages for one session",
        "description": "Resolves the session's owning backend and converts its native history. With `offset=-1` (the default), the current implementation returns the complete conversation rather than only the last `limit` rows.",
        "operationId": "getSessionMessages",
        "x-xo-risk": "workspace-data",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionId"
          },
          {
            "$ref": "#/components/parameters/Limit50"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Zero-based offset. Use -1 for the full current conversation.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": -1,
              "minimum": -1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Message page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagesPage"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/usage": {
      "get": {
        "tags": ["Usage"],
        "summary": "Read the usage dashboard",
        "description": "Returns aggregated local usage for the active agent. The server clamps `days` to 1–365 and treats any timezone other than `local` or `utc` as `local`.",
        "operationId": "getUsageDashboard",
        "x-xo-risk": "workspace-data",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "description": "Number of days to include. Values are clamped to 1–365.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 365
            }
          },
          {
            "name": "tz",
            "in": "query",
            "description": "Timezone for day buckets.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["local", "utc"],
              "default": "local"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Backend-specific usage dashboard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlexibleObject"
                }
              }
            }
          },
          "501": {
            "$ref": "#/components/responses/CapabilityUnavailable"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "WorkspaceProxyBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Workspace proxy token",
        "description": "Optional token enforced by some remote workspace proxies. The Cowork FastAPI app itself does not validate this header. Do not paste XO, model-provider, gateway, poll, or connector secrets here."
      },
      "CoderSessionToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Coder-Session-Token",
        "description": "Optional Coder workspace-proxy session token. It is not an XO API key and is ignored by the Cowork FastAPI app when no validating proxy is present."
      }
    },
    "parameters": {
      "SessionId": {
        "name": "session_id",
        "in": "path",
        "description": "Runtime-native session identifier.",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "Limit50": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of rows in a normal page.",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 50,
          "minimum": 1
        }
      },
      "Offset0": {
        "name": "offset",
        "in": "query",
        "description": "Zero-based row offset.",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "The requested workspace resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "CapabilityUnavailable": {
        "description": "The active agent backend does not expose this capability.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationError": {
        "description": "A path or query parameter failed FastAPI validation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ServiceStatus": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "const": "XO Cowork API running"
          }
        },
        "additionalProperties": false
      },
      "WorkspaceConfiguration": {
        "type": "object",
        "required": ["roots", "default"],
        "properties": {
          "roots": {
            "type": "object",
            "description": "Absolute workspace paths keyed by agent backend.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "default": {
            "type": "string",
            "description": "Active agent backend. Its root is the canonical projects directory."
          }
        },
        "additionalProperties": false
      },
      "AgentSummary": {
        "type": "object",
        "description": "Backend-specific agent summary. Common fields are documented; adapters may add more.",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "workspace": {
            "type": ["string", "null"]
          },
          "backend": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": true
      },
      "Session": {
        "type": "object",
        "required": ["id"],
        "description": "Normalized session metadata. Fields vary slightly by runtime adapter.",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": ["string", "null"]
          },
          "directory": {
            "type": ["string", "null"]
          },
          "backend": {
            "type": ["string", "null"]
          },
          "created_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "updated_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "additionalProperties": true
      },
      "SessionSearchResult": {
        "type": "object",
        "required": ["session", "snippet"],
        "properties": {
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "snippet": {
            "type": ["string", "null"],
            "description": "Reserved for a future search excerpt; currently null."
          }
        },
        "additionalProperties": false
      },
      "Message": {
        "type": "object",
        "description": "Normalized runtime message. Tool-call and provider-specific fields may also be present.",
        "properties": {
          "id": {
            "type": ["string", "null"]
          },
          "role": {
            "type": ["string", "null"],
            "enum": ["user", "assistant", "tool", null]
          },
          "text": {
            "type": ["string", "null"]
          },
          "timestamp": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "additionalProperties": true
      },
      "MessagesPage": {
        "type": "object",
        "required": ["total", "offset", "messages"],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": ["detail"],
        "properties": {
          "detail": {
            "description": "Human-readable string or structured FastAPI error detail"
          }
        },
        "additionalProperties": true
      },
      "FlexibleObject": {
        "type": "object",
        "description": "The active agent adapter controls this response shape.",
        "additionalProperties": true
      }
    }
  }
}
